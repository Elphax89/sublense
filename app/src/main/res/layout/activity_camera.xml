<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cam_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/cam_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Frozen frame or a picked photo -->
    <ImageView
        android:id="@+id/cam_still"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <app.sublens.CameraOverlayView
        android:id="@+id/cam_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top: back · From ⇅ To · flashlight -->
    <LinearLayout
        android:id="@+id/cam_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/cam_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_round_dark"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/cam_from"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@color/text_main"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/cam_swap"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_round_dark"
            android:contentDescription="@string/cd_swap_langs"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_swap" />

        <TextView
            android:id="@+id/cam_to"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/cam_flash"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_round_dark"
            android:contentDescription="@string/cam_flash"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_flash" />
    </LinearLayout>

    <TextView
        android:id="@+id/cam_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="70dp"
        android:background="@drawable/bg_pill"
        android:gravity="center"
        android:maxWidth="320dp"
        android:paddingStart="14dp"
        android:paddingTop="7dp"
        android:paddingEnd="14dp"
        android:paddingBottom="7dp"
        android:textColor="@color/text_main"
        android:textSize="13sp" />

    <!-- Bottom: QR card above the controls -->
    <LinearLayout
        android:id="@+id/cam_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:id="@+id/cam_qr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_qr_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cam_qr_title"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cam_qr_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="middle"
                android:maxLines="2"
                android:textColor="@color/text_main"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/cam_qr_open"
                    style="@style/SubLens.ButtonSmall"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/cam_qr_open" />

                <Button
                    android:id="@+id/cam_qr_lens"
                    style="@style/SubLens.ButtonSmall"
                    android:layout_width="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1.4"
                    android:background="@drawable/bg_button_primary"
                    android:text="@string/cam_qr_open_lens"
                    android:textColor="@color/on_accent" />

                <Button
                    android:id="@+id/cam_qr_copy"
                    style="@style/SubLens.ButtonSmall"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="8dp"
                    android:minWidth="0dp"
                    android:text="@string/cam_copy" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/cam_gallery"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_round_dark"
                android:contentDescription="@string/cam_gallery"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_gallery" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/cam_shutter"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_shutter"
                android:contentDescription="@string/cam_shutter"
                android:scaleType="center" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/cam_copy"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_round_dark"
                android:contentDescription="@string/cam_copy_all"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_copy_white"
                android:visibility="gone" />

            <TextView
                android:id="@+id/cam_original"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/cam_original"
                android:textColor="@color/text_main"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Without camera permission -->
    <LinearLayout
        android:id="@+id/cam_perm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/cam_perm_needed"
            android:textColor="@color/text_main"
            android:textSize="16sp" />

        <Button
            android:id="@+id/cam_perm_btn"
            style="@style/SubLens.ButtonSmall"
            android:layout_marginTop="16dp"
            android:text="@string/cam_perm_button" />
    </LinearLayout>
</FrameLayout>
