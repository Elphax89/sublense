<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="20dp"
        android:paddingEnd="18dp"
        android:paddingBottom="28dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:importantForAccessibility="no"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_main"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_tagline"
                    android:textColor="@color/text_dim"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Permissions -->
        <LinearLayout style="@style/SubLens.Card"
            android:layout_marginTop="22dp">

            <TextView
                style="@style/SubLens.CardTitle"
                android:text="@string/section_permissions" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/perm_overlay_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_main"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btn_overlay"
                    style="@style/SubLens.ButtonSmall"
                    android:text="@string/perm_grant" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_notif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/perm_notif_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_main"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btn_notif"
                    style="@style/SubLens.ButtonSmall"
                    android:text="@string/perm_grant" />
            </LinearLayout>
        </LinearLayout>

        <!-- Start -->
        <Button
            android:id="@+id/btn_start"
            style="@style/SubLens.ButtonPrimary"
            android:layout_marginTop="18dp"
            android:text="@string/start" />

        <TextView
            style="@style/SubLens.Note"
            android:text="@string/start_hint" />

        <!-- Camera: menus, signs, QR codes, photos -->
        <Button
            android:id="@+id/btn_camera"
            style="@style/SubLens.ButtonPrimary"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_outline"
            android:text="@string/btn_camera"
            android:textColor="@color/accent" />

        <TextView
            style="@style/SubLens.Note"
            android:text="@string/camera_note" />

        <!-- Language -->
        <LinearLayout style="@style/SubLens.Card"
            android:layout_marginTop="20dp">

            <TextView
                style="@style/SubLens.CardTitle"
                android:text="@string/section_language" />

            <TextView
                style="@style/SubLens.Caption"
                android:text="@string/label_from" />

            <Spinner
                android:id="@+id/spinner_source"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <ImageButton
                android:id="@+id/btn_swap_langs"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_chip"
                android:contentDescription="@string/cd_swap_langs"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_swap"
                android:tint="@color/accent" />

            <TextView
                style="@style/SubLens.Caption"
                android:text="@string/label_to" />

            <Spinner
                android:id="@+id/spinner_target"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <LinearLayout
                android:id="@+id/row_script"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SubLens.Caption"
                    android:text="@string/label_script" />

                <Spinner
                    android:id="@+id/spinner_script"
                    android:layout_width="match_parent"
                    android:layout_height="48dp" />
            </LinearLayout>

            <TextView
                style="@style/SubLens.Note"
                android:text="@string/language_note" />
        </LinearLayout>

        <!-- Display -->
        <LinearLayout style="@style/SubLens.Card">

            <TextView
                style="@style/SubLens.CardTitle"
                android:text="@string/section_display" />

            <TextView
                style="@style/SubLens.Caption"
                android:text="@string/label_lens_color" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/row_lens_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="8dp" />
            </HorizontalScrollView>

            <TextView
                style="@style/SubLens.Caption"
                android:text="@string/label_mode" />

            <RadioGroup
                android:id="@+id/radio_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radio_lens"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/mode_lens_long"
                    android:textColor="@color/text_main" />

                <RadioButton
                    android:id="@+id/radio_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/mode_bar_long"
                    android:textColor="@color/text_main" />
            </RadioGroup>

            <TextView
                android:id="@+id/label_bar_pos"
                style="@style/SubLens.Caption"
                android:text="@string/label_bar" />

            <RadioGroup
                android:id="@+id/radio_bar_pos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radio_above"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="@string/bar_above"
                    android:textColor="@color/text_main" />

                <RadioButton
                    android:id="@+id/radio_below"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="@string/bar_below"
                    android:textColor="@color/text_main" />
            </RadioGroup>

            <TextView
                android:id="@+id/label_text_size"
                style="@style/SubLens.Caption" />

            <SeekBar
                android:id="@+id/seek_text_size"
                android:layout_width="match_parent"
                android:layout_height="36dp" />

            <Switch
                android:id="@+id/switch_original"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/show_original"
                android:textColor="@color/text_main"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Reply line -->
        <LinearLayout style="@style/SubLens.Card">

            <TextView
                style="@style/SubLens.CardTitle"
                android:text="@string/section_reply" />

            <Switch
                android:id="@+id/switch_composer"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:text="@string/composer_switch"
                android:textColor="@color/text_main"
                android:textSize="15sp" />

            <TextView
                style="@style/SubLens.Caption"
                android:text="@string/label_reply" />

            <Spinner
                android:id="@+id/spinner_reply"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <TextView
                style="@style/SubLens.Note"
                android:text="@string/reply_note" />
        </LinearLayout>

        <!-- Refresh -->
        <LinearLayout style="@style/SubLens.Card">

            <TextView
                style="@style/SubLens.CardTitle"
                android:text="@string/section_speed" />

            <RadioGroup
                android:id="@+id/radio_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radio_fast"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="@string/speed_fast"
                    android:textColor="@color/text_main" />

                <RadioButton
                    android:id="@+id/radio_normal"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="@string/speed_normal"
                    android:textColor="@color/text_main" />

                <RadioButton
                    android:id="@+id/radio_saver"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="@string/speed_saver"
                    android:textColor="@color/text_main" />
            </RadioGroup>
        </LinearLayout>

        <!-- Language packs -->
        <LinearLayout style="@style/SubLens.Card">

            <TextView
                style="@style/SubLens.CardTitle"
                android:text="@string/section_models" />

            <TextView
                style="@style/SubLens.Note"
                android:layout_marginTop="6dp"
                android:text="@string/models_hint" />

            <Switch
                android:id="@+id/switch_wifi"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:text="@string/wifi_only"
                android:textColor="@color/text_main"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/models_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <!-- Download any language pack by hand -->
            <TextView
                style="@style/SubLens.Caption"
                android:layout_marginTop="12dp"
                android:text="@string/models_pick" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/spinner_model"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btn_download_model"
                    style="@style/SubLens.ButtonSmall"
                    android:layout_marginStart="8dp"
                    android:text="@string/models_download" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/SubLens.Note"
            android:layout_marginTop="20dp"
            android:gravity="center_horizontal"
            android:text="@string/footer" />

        <!-- Updates: big button, turns into "New version … install" -->
        <Button
            android:id="@+id/btn_update"
            style="@style/SubLens.ButtonPrimary"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_button_outline"
            android:minHeight="56dp"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:text="@string/update_check"
            android:textColor="@color/accent" />

        <TextView
            android:id="@+id/version_line"
            style="@style/SubLens.Note"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal" />
    </LinearLayout>
</ScrollView>
