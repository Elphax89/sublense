<?xml version="1.0" encoding="utf-8"?>
<!--
  Home screen: header with app language · start area (start, camera, online AI) · Language · Translation ·
  Lens · Offline language packs · version. Same order as the desktop panel.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <!-- ============================================================ Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:importantForAccessibility="no"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_main"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_tagline"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- App language -->
            <LinearLayout
                android:id="@+id/btn_app_lang"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_lang_chip"
                android:contentDescription="@string/app_language"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/app_lang_flag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/app_lang_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/text_main"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_expand" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================================================ Permissions (only while missing) -->
        <LinearLayout
            android:id="@+id/card_permissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_warn"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/SubLens.CardTitle"
                android:text="@string/section_permissions" />

            <LinearLayout
                android:id="@+id/row_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/perm_overlay_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_main"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btn_overlay"
                    style="@style/SubLens.ButtonSmall"
                    android:text="@string/perm_grant" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_notif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/perm_notif_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_main"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btn_notif"
                    style="@style/SubLens.ButtonSmall"
                    android:text="@string/perm_grant" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================================================ Start area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_hero"
            android:orientation="vertical"
            android:padding="14dp">

            <Button
                android:id="@+id/btn_start"
                style="@style/SubLens.ButtonPrimary"
                android:layout_height="58dp"
                android:drawablePadding="8dp"
                android:text="@string/start"
                android:textSize="18sp" />

            <LinearLayout
                android:id="@+id/row_how"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_setting_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingTop="6dp"
                android:paddingEnd="4dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/start_hint_short"
                    android:textColor="@color/text_dim"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/how_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/how_it_works"
                    android:textColor="@color/accent"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/how_text"
                style="@style/SubLens.Note"
                android:layout_marginTop="2dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/start_hint"
                android:textSize="12.5sp"
                android:visibility="gone" />

            <!-- Shortcuts -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btn_camera"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tile"
                    android:minHeight="92dp"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:text="📷"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/tile_camera"
                        android:textColor="@color/text_main"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tile_camera_sub"
                        android:textColor="@color/text_dim"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_online_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tile"
                    android:minHeight="92dp"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:importantForAccessibility="no"
                            android:text="✨"
                            android:textSize="22sp" />

                        <View
                            android:id="@+id/online_dot"
                            android:layout_width="10dp"
                            android:layout_height="10dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/tile_online"
                        android:textColor="@color/text_main"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/online_tile_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_dim"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ============================================================ Language -->
        <LinearLayout style="@style/SubLens.Section">

            <TextView
                style="@style/SubLens.SectionTitle"
                android:text="@string/section_language" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/pill_source"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field_button"
                    android:minHeight="66dp"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_from"
                        android:textColor="@color/text_dim"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/value_source"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/text_main"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_swap_langs"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_swap_round"
                    android:contentDescription="@string/cd_swap_langs"
                    android:padding="9dp"
                    android:rotation="90"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_swap"
                    android:tint="@color/accent" />

                <LinearLayout
                    android:id="@+id/pill_target"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field_button"
                    android:minHeight="66dp"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_to"
                        android:textColor="@color/text_dim"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/value_target"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/text_main"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_script"
                style="@style/SubLens.SettingRow"
                android:layout_marginTop="6dp">

                <TextView
                    style="@style/SubLens.RowTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/label_script" />

                <TextView
                    android:id="@+id/value_script"
                    style="@style/SubLens.RowValue" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_reply"
                style="@style/SubLens.SettingRow">

                <TextView
                    style="@style/SubLens.RowTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/label_reply" />

                <TextView
                    android:id="@+id/value_reply"
                    style="@style/SubLens.RowValue" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================================================ Translation -->
        <LinearLayout style="@style/SubLens.Section">

            <TextView
                style="@style/SubLens.SectionTitle"
                android:text="@string/section_translation" />

            <LinearLayout
                android:id="@+id/seg_engine"
                style="@style/SubLens.Segmented"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/engine_status"
                style="@style/SubLens.RowSub"
                android:layout_marginTop="8dp"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/row_online"
                style="@style/SubLens.SettingRow"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/online_row_title"
                    style="@style/SubLens.RowTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/service_key" />

                <TextView
                    android:id="@+id/value_online"
                    style="@style/SubLens.RowValue" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================================================ Lens -->
        <LinearLayout style="@style/SubLens.Section">

            <TextView
                style="@style/SubLens.SectionTitle"
                android:text="@string/section_lens" />

            <TextView
                style="@style/SubLens.Caption"
                android:layout_marginTop="8dp"
                android:text="@string/label_lens_color" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/row_lens_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />
            </HorizontalScrollView>

            <TextView
                style="@style/SubLens.Caption"
                android:text="@string/label_mode" />

            <LinearLayout
                android:id="@+id/seg_mode"
                style="@style/SubLens.Segmented" />

            <TextView
                android:id="@+id/mode_hint"
                style="@style/SubLens.RowSub"
                android:layout_marginTop="6dp" />

            <LinearLayout
                android:id="@+id/box_bar_pos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SubLens.Caption"
                    android:text="@string/label_bar" />

                <LinearLayout
                    android:id="@+id/seg_bar_pos"
                    style="@style/SubLens.Segmented" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/SubLens.RowTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/text_size" />

                <TextView
                    android:id="@+id/value_text_size"
                    style="@style/SubLens.RowValue" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seek_text_size"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginStart="-12dp"
                android:layout_marginEnd="-12dp" />

            <View style="@style/SubLens.Divider" />

            <!-- Switch rows -->
            <LinearLayout
                android:id="@+id/row_original"
                style="@style/SubLens.SettingRow">

                <TextView
                    style="@style/SubLens.RowTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/show_original" />

                <Switch
                    android:id="@+id/switch_original"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_video"
                style="@style/SubLens.SettingRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SubLens.RowTitle"
                        android:text="@string/video_title" />

                    <TextView
                        style="@style/SubLens.RowSub"
                        android:text="@string/video_sub" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_video"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_composer"
                style="@style/SubLens.SettingRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SubLens.RowTitle"
                        android:text="@string/composer_title" />

                    <TextView
                        style="@style/SubLens.RowSub"
                        android:text="@string/composer_sub" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_composer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <View style="@style/SubLens.Divider" />

            <TextView
                style="@style/SubLens.Caption"
                android:layout_marginTop="8dp"
                android:text="@string/section_speed" />

            <LinearLayout
                android:id="@+id/seg_speed"
                style="@style/SubLens.Segmented"
                android:layout_marginBottom="6dp" />
        </LinearLayout>

        <!-- ============================================================ Offline language packs -->
        <LinearLayout style="@style/SubLens.Section">

            <LinearLayout
                android:id="@+id/row_models"
                style="@style/SubLens.SettingRow"
                android:layout_marginTop="-8dp">

                <TextView
                    style="@style/SubLens.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_marginBottom="0dp"
                    android:layout_weight="1"
                    android:text="@string/section_models" />

                <TextView
                    android:id="@+id/value_models"
                    style="@style/SubLens.RowValue"
                    android:textColor="@color/text_dim" />

                <ImageView
                    android:id="@+id/models_expand"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_expand" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/models_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/SubLens.RowSub"
                    android:text="@string/models_hint" />

                <LinearLayout
                    android:id="@+id/row_wifi"
                    style="@style/SubLens.SettingRow">

                    <TextView
                        style="@style/SubLens.RowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/wifi_only" />

                    <Switch
                        android:id="@+id/switch_wifi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/models_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/pill_model"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_field_button"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="7dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/models_pick"
                            android:textColor="@color/text_dim"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/value_model"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/text_main"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_download_model"
                        style="@style/SubLens.ButtonSmall"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:text="@string/models_download" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ============================================================ About -->
        <TextView
            android:id="@+id/footer"
            style="@style/SubLens.Note"
            android:layout_marginTop="20dp"
            android:gravity="center_horizontal" />

        <!-- Updates: turns into "New version … install" -->
        <Button
            android:id="@+id/btn_update"
            style="@style/SubLens.ButtonPrimary"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_button_outline"
            android:minHeight="52dp"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:text="@string/update_check"
            android:textColor="@color/accent"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/version_line"
            style="@style/SubLens.Note"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal" />
    </LinearLayout>
</ScrollView>
