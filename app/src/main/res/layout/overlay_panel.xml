<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="16dp">

    <!-- Kopfzeile -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/panel_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back"
            android:visibility="gone" />

        <TextView
            android:id="@+id/panel_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/panel_title"
            android:textColor="@color/text_main"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/panel_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_close"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Hauptseite -->
    <ScrollView
        android:id="@+id/page_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingEnd="6dp">

        <TextView
            style="@style/SubLens.Caption"
            android:layout_marginTop="6dp"
            android:text="@string/label_from" />

        <TextView
            android:id="@+id/value_from"
            style="@style/SubLens.Row" />

        <ImageButton
            android:id="@+id/btn_swap_langs"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_chip"
            android:contentDescription="@string/cd_swap_langs"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_swap" />

        <TextView
            style="@style/SubLens.Caption"
            android:text="@string/label_to" />

        <TextView
            android:id="@+id/value_to"
            style="@style/SubLens.Row" />

        <TextView
            style="@style/SubLens.Caption"
            android:text="@string/label_mode" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/choice_lens"
                style="@style/SubLens.Choice"
                android:text="@string/choice_lens" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/choice_bar"
                style="@style/SubLens.Choice"
                android:text="@string/choice_bar" />
        </LinearLayout>

        <TextView
            android:id="@+id/label_bar_pos"
            style="@style/SubLens.Caption"
            android:text="@string/label_bar" />

        <LinearLayout
            android:id="@+id/row_bar_pos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/choice_above"
                style="@style/SubLens.Choice"
                android:text="@string/choice_above" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/choice_below"
                style="@style/SubLens.Choice"
                android:text="@string/choice_below" />
        </LinearLayout>

        <TextView
            style="@style/SubLens.Caption"
            android:text="@string/label_composer" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/choice_composer_on"
                style="@style/SubLens.Choice"
                android:text="@string/choice_on" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/choice_composer_off"
                style="@style/SubLens.Choice"
                android:text="@string/choice_off" />
        </LinearLayout>

        <TextView
            style="@style/SubLens.Caption"
            android:text="@string/label_reply" />

        <TextView
            android:id="@+id/value_reply"
            style="@style/SubLens.Row" />

        <TextView
            android:id="@+id/open_app"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/panel_open_app"
            android:textColor="@color/accent"
            android:textSize="14sp" />
    </LinearLayout>
    </ScrollView>

    <!-- Sprachliste -->
    <ScrollView
        android:id="@+id/list_scroll"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="6dp"
        android:fadeScrollbars="false"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingEnd="6dp" />
    </ScrollView>
</LinearLayout>
