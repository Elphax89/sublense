<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same as backup_rules.xml – encrypted API keys stay on this phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sublens_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sublens_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
